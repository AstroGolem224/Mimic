[Unit]
Description=Mimic GPU worker
# Der Worker beendet sich planmaessig staendig (Leerlauf-Exit ist der Weg, auf
# dem VRAM und RAM zuverlaessig zurueckkommen). Mit systemds Vorgabe von fuenf
# Starts je zehn Sekunden reisst er das Limit und systemd nimmt dann die
# SOCKET-Unit mit ins Aus -- Mimic ist danach dauerhaft tot, bis jemand von
# Hand reset-failed ruft. Beobachtet am 2026-08-05 beim Eindaemmungstest.
# Ungefaehrlich, weil Restart=no gilt: Starts kommen nur von Verbindungen,
# also vom Client, nicht von systemd in einer Schleife.
StartLimitIntervalSec=0
# StartLimitIntervalSec gehoert in [Unit]; in [Service] wird es stillschweigend
# ignoriert ("Unknown key ... ignoring") -- geprueft mit systemd-analyze verify.
Requires=mimic-worker.socket
After=mimic-worker.socket

[Service]
Type=simple
ExecStart=%h/.local/bin/mimic-worker
Environment=HF_HUB_OFFLINE=1
# numba (ueber librosa) legt seinen JIT-Cache sonst neben die Quelldateien --
# unter ProtectHome=read-only scheitert der Worker daran beim ersten Laden.
Environment=NUMBA_CACHE_DIR=%t/mimic/numba
# Explizit, damit ein gesetztes XDG_CACHE_HOME die Checkpoints nicht verlegt:
# offline plus falscher Cache-Pfad ergibt "kein Snapshot gefunden".
Environment=HF_HOME=%h/.cache/huggingface
Restart=no
# 6G, nicht 3G. Die 3 GiB stammten aus 08_ram.py, das OHNE Klonen gemessen hat
# (Ruhezustand 2269 MiB). Im Dienst liegen die RSS-Spitzen bei 4.0-4.6 GiB,
# weil Referenzaudio und Konditionierung dazukommen. Unterhalb der Spitze
# drosselt der Kernel bei jeder Anfrage und reclaimt -- gemessen am 2026-08-05.
# Erst 5G, aber auch dort noch 17970 Drosselereignisse (memory.events high) --
# die RSS-Spitze liegt bei 5.05 GiB. MemoryMax bleibt 7G als harte Grenze,
# die laut memory.events nie erreicht wird.
MemoryHigh=6G
MemoryMax=7G
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/mimic/voices %t/mimic
