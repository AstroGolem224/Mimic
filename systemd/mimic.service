[Unit]
Description=Mimic CPU frontend
Requires=mimic.socket
After=mimic.socket
# Gehoert in [Unit]; in [Service] wird es stillschweigend ignoriert. Siehe die
# Begruendung in mimic.socket -- beide Units brauchen es, sonst reisst die eine
# die andere mit ins failed.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=%h/.local/bin/mimic-frontend
Restart=no
MemoryHigh=256M
MemoryMax=512M
RestrictAddressFamilies=AF_UNIX
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/mimic/voices %t/mimic
